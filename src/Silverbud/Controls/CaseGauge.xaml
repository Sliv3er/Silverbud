<UserControl x:Class="Silverbud.Controls.CaseGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The charging case: opaque base, clear lid, and a front light strip as the charge level -->
        <Grid Width="132" Height="88" VerticalAlignment="Center">
            <Border CornerRadius="27" BorderThickness="1"
                    Background="{StaticResource CaseBodyBrush}" BorderBrush="{StaticResource RimBrush}" />
            <Border Height="39" Margin="1" VerticalAlignment="Top" CornerRadius="26,26,4,4"
                    Background="{StaticResource LidBrush}" />
            <Border Height="1" Margin="11,40,11,0" VerticalAlignment="Top" Background="{StaticResource RimBrush}" />
            <Grid Width="52" Height="5" Margin="0,0,0,18" VerticalAlignment="Bottom">
                <Border CornerRadius="2.5" Background="{StaticResource TrackBrush}" />
                <Border x:Name="Light" CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LightScale" ScaleX="0" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="12" Opacity="0.9" />
                    </Border.Effect>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="1" Width="96" Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CASE" Style="{StaticResource Eyebrow}" />
            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                <TextBlock x:Name="Number" Text="—" Style="{StaticResource GaugeNumber}" />
                <TextBlock x:Name="Percent" Text="%" Style="{StaticResource GaugeUnit}" />
            </StackPanel>
            <TextBlock x:Name="StateText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SteelBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
