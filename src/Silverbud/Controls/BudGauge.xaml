<UserControl x:Class="Silverbud.Controls.BudGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- A Buds3 earbud: round head, long stem, and the stem's blade light doubling as the charge level -->
        <Viewbox Height="126" Stretch="Uniform">
            <Grid Width="96" Height="150">
                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="Mirror" ScaleX="1" />
                    </Grid.RenderTransform>
                    <Border Width="30" Height="114" Margin="18,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            CornerRadius="15" BorderThickness="1"
                            Background="{StaticResource MetalStemBrush}" BorderBrush="{StaticResource RimBrush}">
                        <Grid Width="5" Margin="6,32,0,14" HorizontalAlignment="Left">
                            <Border CornerRadius="2.5" Background="{StaticResource TrackBrush}" />
                            <Border x:Name="Light" CornerRadius="2.5" RenderTransformOrigin="0.5,1">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="LightScale" ScaleY="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect x:Name="Glow" ShadowDepth="0" BlurRadius="12" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                    <Ellipse Width="58" Height="58" Margin="30,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{StaticResource MetalHeadBrush}" Stroke="{StaticResource RimBrush}" />
                    <Ellipse Width="20" Height="20" Margin="49,19,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Fill="{StaticResource MeshBrush}" />
                </Grid>
            </Grid>
        </Viewbox>

        <StackPanel x:Name="Readout" Grid.Column="1" Width="92" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="CaptionText" Style="{StaticResource Eyebrow}" />
            <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                <TextBlock x:Name="Number" Text="—" Style="{StaticResource GaugeNumber}" />
                <TextBlock x:Name="Percent" Text="%" Style="{StaticResource GaugeUnit}" />
            </StackPanel>
            <TextBlock x:Name="StateText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource SteelBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
