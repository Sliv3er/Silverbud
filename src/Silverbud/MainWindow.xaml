<Window x:Class="Silverbud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Silverbud.Controls"
        Title="Silverbud" Width="1100" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/silverbud.ico"
        Background="{StaticResource AlloyBrush}" Foreground="{StaticResource GraphiteBrush}"
        FontFamily="{StaticResource BodyFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ───── Title bar ───── -->
        <Grid Grid.Row="0">
            <StackPanel Margin="20,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <Image Width="20" Height="20" Source="Assets/silverbud.ico" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="Silverbud"
                           FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Margin="10,1,0,0" VerticalAlignment="Center" Text="Galaxy Buds3 manager"
                           FontSize="12.5" Foreground="{StaticResource SteelBrush}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize" AutomationProperties.Name="Maximize" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ───── Device rail ───── -->
            <Border Background="{StaticResource RailBrush}" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,1,0">
                <DockPanel Margin="16,20,16,16">
                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Margin="4,0,4,12" Text="{Binding RailMessage}" Style="{StaticResource Hint}"
                                   Visibility="{Binding RailMessage, Converter={StaticResource TextVis}}" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Command="{Binding ScanCommand}"
                                AutomationProperties.Name="{Binding ScanLabel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,1,9,0" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE702;" />
                                <TextBlock Text="{Binding ScanLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,10,0,0" HorizontalAlignment="Center" Style="{StaticResource LinkButton}" FontWeight="Normal"
                                Foreground="{StaticResource SteelBrush}" FontSize="12.5"
                                Content="Windows Bluetooth settings" Command="{Binding OpenBluetoothSettingsCommand}" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="4,0,0,10" Text="YOUR BUDS" Style="{StaticResource Eyebrow}" />
                            <ListBox Style="{StaticResource DeviceList}" ItemContainerStyle="{StaticResource DeviceRow}"
                                     ItemsSource="{Binding PairedDevices}" SelectedItem="{Binding Selected}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="8" Height="8" Margin="0,6,12,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#A3ABB4" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource LedGreenBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,2,0,0" Text="{Binding Address}" Style="{StaticResource Mono}" FontSize="11.5" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="4,2,4,0" Style="{StaticResource Hint}"
                                       Visibility="{Binding ShowNoPairedHint, Converter={StaticResource BoolVis}}"
                                       Text="No Galaxy Buds are paired with this PC yet. Select Find buds to pair below." />

                            <StackPanel Margin="0,22,0,0" Visibility="{Binding ShowNearby, Converter={StaticResource BoolVis}}">
                                <TextBlock Margin="4,0,0,10" Text="NEARBY, READY TO PAIR" Style="{StaticResource Eyebrow}" />
                                <ItemsControl ItemsSource="{Binding NearbyDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="12" Background="{StaticResource SheetBrush}"
                                                    BorderBrush="{StaticResource RimBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,2,0,0" Text="{Binding Address}" Style="{StaticResource Mono}" FontSize="11.5" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="14,6" Style="{StaticResource PrimaryButton}" Content="Pair"
                                                            Command="{Binding DataContext.PairCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding IsPairing, Converter={StaticResource InvBoolVis}}" />
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="Pairing…"
                                                               Foreground="{StaticResource SteelBrush}" FontSize="12.5"
                                                               Visibility="{Binding IsPairing, Converter={StaticResource BoolVis}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ───── Nothing selected ───── -->
            <StackPanel Grid.Column="1" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource InvBoolVis}}">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Opacity="0.75">
                    <c:BudGauge Caption="" />
                    <c:BudGauge Caption="" Mirrored="True" />
                </StackPanel>
                <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Text="Pair your Galaxy Buds3"
                           FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Margin="0,10,0,0" TextAlignment="Center" Style="{StaticResource Hint}" FontSize="13.5" LineHeight="20"
                           Text="Open the case with both buds inside and keep it next to the PC. Then select Find buds to pair on the left." />
            </StackPanel>

            <!-- ───── Selected buds ───── -->
            <Grid Grid.Column="1" Margin="30,20,30,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Selected.Name}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Border Padding="9,3,11,4" CornerRadius="11">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#D8DDE2" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PillState}" Value="on">
                                                <Setter Property="Background" Value="#D7EEE2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PillState}" Value="busy">
                                                <Setter Property="Background" Value="#F4E6D0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#8A939D" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PillState}" Value="on">
                                                        <Setter Property="Fill" Value="{StaticResource LedGreenBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PillState}" Value="busy">
                                                        <Setter Property="Fill" Value="{StaticResource LedAmberBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding PillText}" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" Text="{Binding Selected.Model}" FontSize="13" Foreground="{StaticResource SteelBrush}" />
                            <TextBlock Margin="10,1,0,0" VerticalAlignment="Center" Text="{Binding Selected.Address}" Style="{StaticResource Mono}" />
                        </StackPanel>
                        <TextBlock Margin="0,10,0,0" MaxWidth="560" HorizontalAlignment="Left" Text="{Binding StatusText}" Style="{StaticResource Hint}" FontSize="13"
                                   Visibility="{Binding StatusText, Converter={StaticResource TextVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectCommand}"
                                Visibility="{Binding IsNotLinked, Converter={StaticResource BoolVis}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Content="Disconnect" Command="{Binding DisconnectCommand}"
                                Visibility="{Binding ShowDisconnect, Converter={StaticResource BoolVis}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource LinkButton}" Content="Forget" Command="{Binding ForgetCommand}"
                                ToolTip="Remove these buds from this PC" />
                    </StackPanel>
                </Grid>

                <!-- The signature: each bud's stem light is its battery level -->
                <Border Grid.Row="1" Padding="24,18" Style="{StaticResource Card}">
                    <!-- Shrinks (never clips) when the window is narrow -->
                    <Viewbox StretchDirection="DownOnly">
                        <StackPanel Orientation="Horizontal">
                            <c:BudGauge Caption="LEFT" Level="{Binding BatteryLeft}" Charging="{Binding ChargingLeft}" State="{Binding StateLeft}" />
                            <c:BudGauge Margin="16,0,0,0" Caption="RIGHT" Mirrored="True" Level="{Binding BatteryRight}" Charging="{Binding ChargingRight}" State="{Binding StateRight}" />
                            <Border Width="1" Margin="22,14,26,14" Background="{StaticResource RimBrush}" />
                            <c:CaseGauge Level="{Binding BatteryCase}" Charging="{Binding ChargingCase}" State="{Binding StateCase}" />
                        </StackPanel>
                    </Viewbox>
                </Border>

                <TabControl Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource Tabs}">

                    <!-- ───── Sound ───── -->
                    <TabItem Header="Sound">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,24">
                                <Border Style="{StaticResource Card}" Padding="16,12" Background="Transparent"
                                        Visibility="{Binding IsNotLinked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="Connect the buds to change these settings." />
                                </Border>
                                <StackPanel IsEnabled="{Binding IsLinked}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Margin="20,16,20,16">
                                                <TextBlock Text="Noise control" Style="{StaticResource CardTitle}" />
                                                <Border Margin="0,12,0,0" Style="{StaticResource SegmentWell}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="nc" Content="Off"
                                                                     IsChecked="{Binding NoiseControl, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="nc" Content="Noise canceling"
                                                                     IsChecked="{Binding NoiseControl, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                                                        <RadioButton Style="{StaticResource Segment}" GroupName="nc" Content="Ambient sound"
                                                                     IsChecked="{Binding NoiseControl, Converter={StaticResource IntEq}, ConverterParameter=2}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <c:SettingRow Title="Ambient sound level" Description="How much of your surroundings you hear."
                                                          Visibility="{Binding NoiseControl, Converter={StaticResource IntEqVis}, ConverterParameter=2}">
                                                <Slider Width="200" Style="{StaticResource HSlider}" Minimum="0" Maximum="2" Value="{Binding AmbientVolume}" />
                                            </c:SettingRow>
                                            <c:SettingRow Title="Customize ambient sound" Description="Set a separate level for each ear and adjust the tone.">
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AmbientCustomOn}" />
                                            </c:SettingRow>
                                            <StackPanel Visibility="{Binding AmbientCustomOn, Converter={StaticResource BoolVis}}">
                                                <c:SettingRow Title="Left ear level">
                                                    <Slider Width="200" Style="{StaticResource HSlider}" Minimum="0" Maximum="2" Value="{Binding AmbientCustomLeft}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Right ear level">
                                                    <Slider Width="200" Style="{StaticResource HSlider}" Minimum="0" Maximum="2" Value="{Binding AmbientCustomRight}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Tone" Description="From softer to clearer.">
                                                    <Slider Width="200" Style="{StaticResource HSlider}" Minimum="0" Maximum="4" Value="{Binding AmbientTone}" />
                                                </c:SettingRow>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Margin="20,16,20,12">
                                                <TextBlock Text="Equalizer" Style="{StaticResource CardTitle}" />
                                                <WrapPanel Margin="0,12,0,0">
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Normal"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=0}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Bass boost"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Soft"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=2}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Dynamic"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=3}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Clear"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=4}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Treble boost"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=5}" />
                                                    <RadioButton Style="{StaticResource Chip}" GroupName="eq" Content="Custom"
                                                                 IsChecked="{Binding EqPreset, Converter={StaticResource IntEq}, ConverterParameter=6}" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <Border Padding="20,14,20,16" BorderBrush="{StaticResource RimBrush}" BorderThickness="0,1,0,0"
                                                    Visibility="{Binding IsCustomEq, Converter={StaticResource BoolVis}}">
                                                <StackPanel>
                                                    <ItemsControl ItemsSource="{Binding EqBands}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Gain, Converter={StaticResource Gain}}"
                                                                               FontFamily="{StaticResource DisplayFont}" FontSize="13" />
                                                                    <Slider Height="130" Margin="0,6" HorizontalAlignment="Center" Style="{StaticResource VSlider}"
                                                                            Minimum="-10" Maximum="10" Value="{Binding Gain}" />
                                                                    <TextBlock HorizontalAlignment="Center" Text="{Binding Label}" Style="{StaticResource Mono}" FontSize="11" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <DockPanel Margin="0,12,0,0">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Reset to flat" Command="{Binding ResetEqCommand}" />
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}"
                                                                   Text="Hz bands. Custom EQ is experimental on Buds3 firmware; the buds forget it when powered off, so Silverbud sends it again each time they connect." />
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Margin="20,16,20,12" Text="Listening" Style="{StaticResource CardTitle}" />
                                            <c:SettingRow Title="Left/right balance" Description="{Binding BalanceText}">
                                                <Grid Width="270">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="L" Style="{StaticResource Eyebrow}" />
                                                    <Slider Grid.Column="1" Margin="10,0" Style="{StaticResource HSlider}" Minimum="0" Maximum="32" Value="{Binding Balance}" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="R" Style="{StaticResource Eyebrow}" />
                                                </Grid>
                                            </c:SettingRow>
                                            <c:SettingRow Title="Game mode" Description="Reduces audio delay so sound stays in sync with games and video.">
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GameMode}" />
                                            </c:SettingRow>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Controls ───── -->
                    <TabItem Header="Controls">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,24">
                                <Border Style="{StaticResource Card}" Padding="16,12" Background="Transparent"
                                        Visibility="{Binding IsNotLinked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="Connect the buds to change these settings." />
                                </Border>
                                <StackPanel IsEnabled="{Binding IsLinked}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Margin="20,16,20,12" Text="Gestures" Style="{StaticResource CardTitle}" />
                                            <c:SettingRow Title="Pinch controls" Description="Turn off to ignore every pinch on both stems.">
                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TouchEnabled}" />
                                            </c:SettingRow>
                                            <StackPanel IsEnabled="{Binding TouchEnabled}">
                                                <c:SettingRow Title="Pinch" Description="Play or pause">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PinchOn}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Double pinch" Description="Next track">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DoublePinchOn}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Triple pinch" Description="Previous track">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TriplePinchOn}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Pinch and hold" Description="Runs the action you choose below">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PinchHoldOn}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Double pinch during calls" Description="Answer or end a call">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DoublePinchCallOn}" />
                                                </c:SettingRow>
                                                <c:SettingRow Title="Pinch and hold during calls" Description="Decline a call">
                                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding PinchHoldCallOn}" />
                                                </c:SettingRow>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" IsEnabled="{Binding PinchHoldOn}">
                                        <StackPanel Margin="20,16,20,18">
                                            <TextBlock Text="Pinch and hold action" Style="{StaticResource CardTitle}" />
                                            <TextBlock Margin="0,14,0,8" Text="LEFT EARBUD" Style="{StaticResource Eyebrow}" />
                                            <Border Style="{StaticResource SegmentWell}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdL" Content="Noise controls"
                                                                 IsChecked="{Binding HoldActionLeft, Converter={StaticResource IntEq}, ConverterParameter=2}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdL" Content="Voice assistant"
                                                                 IsChecked="{Binding HoldActionLeft, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdL" Content="Volume down"
                                                                 IsChecked="{Binding HoldActionLeft, Converter={StaticResource IntEq}, ConverterParameter=3}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdL" Content="Spotify"
                                                                 IsChecked="{Binding HoldActionLeft, Converter={StaticResource IntEq}, ConverterParameter=4}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Margin="0,16,0,8" Text="RIGHT EARBUD" Style="{StaticResource Eyebrow}" />
                                            <Border Style="{StaticResource SegmentWell}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdR" Content="Noise controls"
                                                                 IsChecked="{Binding HoldActionRight, Converter={StaticResource IntEq}, ConverterParameter=2}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdR" Content="Voice assistant"
                                                                 IsChecked="{Binding HoldActionRight, Converter={StaticResource IntEq}, ConverterParameter=1}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdR" Content="Volume up"
                                                                 IsChecked="{Binding HoldActionRight, Converter={StaticResource IntEq}, ConverterParameter=3}" />
                                                    <RadioButton Style="{StaticResource Segment}" GroupName="holdR" Content="Spotify"
                                                                 IsChecked="{Binding HoldActionRight, Converter={StaticResource IntEq}, ConverterParameter=4}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <c:SettingRow Title="Double-tap earbud edge" BorderThickness="0"
                                                      Description="Double-tap the edge of the left or right earbud to turn the volume down or up.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DoubleTapEdgeVolume}" />
                                        </c:SettingRow>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Find ───── -->
                    <TabItem Header="Find">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,24">
                                <Border Style="{StaticResource Card}" Padding="16,12" Background="Transparent"
                                        Visibility="{Binding IsNotLinked, Converter={StaticResource BoolVis}}">
                                    <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="The buds must be connected to this PC to ring." />
                                </Border>
                                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsLinked}">
                                    <StackPanel>
                                        <Grid Margin="20,18,20,18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="Find your buds" Style="{StaticResource CardTitle}" />
                                                <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}" FontSize="13"
                                                           Text="The buds play a loud beep until you stop them. Take them out of your ears first." />
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Padding="26,11" Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding RingLabel}" Command="{Binding RingCommand}" />
                                        </Grid>
                                        <c:SettingRow Title="Mute left earbud" Description="Ring only the bud you're looking for.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MuteLeft}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Mute right earbud">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MuteRight}" />
                                        </c:SettingRow>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───── Device ───── -->
                    <TabItem Header="Device">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,6,24">
                                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsLinked}">
                                    <StackPanel>
                                        <TextBlock Margin="20,16,20,12" Text="Calls" Style="{StaticResource CardTitle}" />
                                        <c:SettingRow Title="In-ear detection for calls"
                                                      Description="Play calls through the buds when they're in your ears, and through the PC when they're not.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CallPathControl}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Use ambient sound during calls" Description="Hear your own voice more naturally while you talk.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Sidetone}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Noise controls with one earbud" Description="Keep noise canceling or ambient sound on while wearing only one bud.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding NoiseControlsWithOneEarbud}" />
                                        </c:SettingRow>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsLinked}">
                                    <StackPanel>
                                        <TextBlock Margin="20,16,20,12" Text="Connections" Style="{StaticResource CardTitle}" />
                                        <c:SettingRow Title="Seamless earbud connection"
                                                      Description="Switch between devices signed in to your Samsung account without pairing again.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Seamless}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Pairing mode" Description="Lets a new phone or computer find the buds. They disconnect from this PC.">
                                            <Button Style="{StaticResource SecondaryButton}" Content="Turn on" Command="{Binding PairingModeCommand}" />
                                        </c:SettingRow>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Margin="20,16,20,12" Text="Silverbud" Style="{StaticResource CardTitle}" />
                                        <c:SettingRow Title="Connect automatically" Description="Open the settings link as soon as Windows connects the buds.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoConnect}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Start with Windows" Description="Starts in the notification area, ready when you put the buds in.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Keep running when closed" Description="Closing the window keeps Silverbud in the notification area for battery alerts.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray}" />
                                        </c:SettingRow>
                                        <c:SettingRow Title="Low battery alert" Description="Get a notification when an earbud drops to 15%.">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LowBatteryAlert}" />
                                        </c:SettingRow>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel Margin="20,16,20,16">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Refresh" Command="{Binding RefreshInfoCommand}" />
                                            <TextBlock Text="About these buds" Style="{StaticResource CardTitle}" />
                                        </DockPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                    <Setter Property="Margin" Value="0,4" />
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="Model" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Selected.Model}" Foreground="{StaticResource GraphiteBrush}" />
                                            <TextBlock Grid.Row="1" Text="Bluetooth address" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Address}" Foreground="{StaticResource GraphiteBrush}" />
                                            <TextBlock Grid.Row="2" Text="Firmware" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Firmware}" Foreground="{StaticResource GraphiteBrush}" />
                                            <TextBlock Grid.Row="3" Text="Hardware" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware}" Foreground="{StaticResource GraphiteBrush}" />
                                            <TextBlock Grid.Row="4" Text="Earbud temperature" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Temperatures}" Foreground="{StaticResource GraphiteBrush}" />
                                            <TextBlock Grid.Row="5" Text="Battery voltage" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Voltages}" Foreground="{StaticResource GraphiteBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" IsEnabled="{Binding IsLinked}">
                                    <c:SettingRow Title="Factory reset" BorderThickness="0"
                                                  Description="Returns every setting to default and makes the buds forget all paired devices, including this PC.">
                                        <Button Style="{StaticResource DangerButton}" Content="Reset buds…" Command="{Binding FactoryResetCommand}" />
                                    </c:SettingRow>
                                </Border>

                                <DockPanel Margin="4,4,4,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" FontWeight="Normal" FontSize="12.5"
                                            Foreground="{StaticResource SteelBrush}" Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Hint}"
                                               Text="Silverbud 1.0 · Protocol details come from the open-source GalaxyBudsClient project." />
                                </DockPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
