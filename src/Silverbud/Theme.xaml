<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Silverbud.Controls">

    <!-- ───── Palette: machined silver, graphite ink; colour is reserved for battery/connection state ───── -->
    <Color x:Key="AlloyColor">#E3E6EA</Color>
    <Color x:Key="SheetColor">#F5F7F9</Color>
    <Color x:Key="RimColor">#CBD1D8</Color>
    <Color x:Key="SteelColor">#646D78</Color>
    <Color x:Key="GraphiteColor">#1D2127</Color>

    <SolidColorBrush x:Key="SheetBrush" Color="{StaticResource SheetColor}" />
    <SolidColorBrush x:Key="RimBrush" Color="{StaticResource RimColor}" />
    <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
    <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
    <SolidColorBrush x:Key="RailBrush" Color="#DCE0E5" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EBEF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#D2D7DD" />
    <SolidColorBrush x:Key="MeshBrush" Color="#C3C9D0" />
    <SolidColorBrush x:Key="SegmentWellBrush" Color="#DDE1E6" />
    <SolidColorBrush x:Key="LedGreenBrush" Color="#2E9E68" />
    <SolidColorBrush x:Key="LedAmberBrush" Color="#D4881E" />
    <SolidColorBrush x:Key="LedRedBrush" Color="#CF4436" />
    <SolidColorBrush x:Key="NoticeBrush" Color="#FBF2E3" />
    <SolidColorBrush x:Key="NoticeRimBrush" Color="#EBCD9C" />

    <LinearGradientBrush x:Key="AlloyBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Offset="0" Color="#ECEEF1" />
        <GradientStop Offset="1" Color="#DCE0E5" />
    </LinearGradientBrush>
    <!-- A brushed cylinder: highlights run down the stem -->
    <LinearGradientBrush x:Key="MetalStemBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#CDD3D9" />
        <GradientStop Offset="0.28" Color="#F8F9FA" />
        <GradientStop Offset="0.55" Color="#DDE1E6" />
        <GradientStop Offset="0.8" Color="#EEF0F3" />
        <GradientStop Offset="1" Color="#BEC5CD" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="MetalHeadBrush" GradientOrigin="0.35,0.3" Center="0.45,0.45" RadiusX="0.65" RadiusY="0.65">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.55" Color="#E3E7EB" />
        <GradientStop Offset="1" Color="#B9C0C8" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="CaseBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#F6F7F9" />
        <GradientStop Offset="1" Color="#CED4DB" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LidBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Offset="0" Color="#E6FFFFFF" />
        <GradientStop Offset="0.5" Color="#80FFFFFF" />
        <GradientStop Offset="1" Color="#40FFFFFF" />
    </LinearGradientBrush>

    <!-- ───── Type: Bahnschrift (DIN, the lettering of engineering labels) + Segoe UI Variable + Cascadia Mono ───── -->
    <FontFamily x:Key="DisplayFont">Bahnschrift</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <c:IntEqualsConverter x:Key="IntEq" />
    <c:IntEqualsVisibilityConverter x:Key="IntEqVis" />
    <c:BoolVisibilityConverter x:Key="BoolVis" />
    <c:BoolVisibilityConverter x:Key="InvBoolVis" Invert="True" />
    <c:TextVisibilityConverter x:Key="TextVis" />
    <c:GainConverter x:Key="Gain" />

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
    </Style>
    <Style x:Key="GaugeNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="GaugeUnit" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="2,0,0,8" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
    </Style>

    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="11" RadiusY="11" SnapsToDevicePixels="True"
                               Stroke="{StaticResource GraphiteBrush}" StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SheetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ───── Buttons ───── -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="10" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#363B43" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0E1114" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource SheetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource RimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#AEB6BF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource LedRedBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource LedRedBrush}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FBEAE8" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="Padding" Value="4,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource SteelBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#D3D8DE" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ───── Toggle switch ───── -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="12" Background="#BEC5CD" />
                        <Ellipse x:Name="Knob" Width="18" Height="18" Margin="3,0" HorizontalAlignment="Left" Fill="White">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GraphiteBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="20" />
                            <Setter TargetName="Knob" Property="Height" Value="20" />
                            <Setter TargetName="Knob" Property="Margin" Value="2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───── Segmented control (radio group inside a recessed well) ───── -->
    <Style x:Key="SegmentWell" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SegmentWellBrush}" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="8" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#CFD5DB" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GraphiteBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Padding="15,7" CornerRadius="17" BorderThickness="1"
                            Background="Transparent" BorderBrush="{StaticResource RimBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#AEB6BF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GraphiteBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GraphiteBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───── Sliders ───── -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Dot" Width="18" Height="18" Fill="{StaticResource MetalHeadBrush}"
                             Stroke="{StaticResource SteelBrush}" StrokeThickness="1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource GraphiteBrush}" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackH" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TrackV" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Width="4" HorizontalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HSlider" TargetType="Slider">
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackH}" Command="Slider.DecreaseLarge" Background="{StaticResource GraphiteBrush}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackH}" Command="Slider.IncreaseLarge" Background="#C3C9D0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="VSlider" TargetType="Slider" BasedOn="{StaticResource HSlider}">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Width="26" Background="Transparent">
                        <!-- Mixing-desk fader: a neutral slot, the knob position is the value -->
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackV}" Command="Slider.DecreaseLarge" Background="#C3C9D0" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackV}" Command="Slider.IncreaseLarge" Background="#C3C9D0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───── Tabs ───── -->
    <Style x:Key="Tabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource RimBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,16,0,0" ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,28,0" Background="Transparent">
                        <ContentPresenter x:Name="Label" Margin="0,6,0,11" ContentSource="Header"
                                          TextElement.FontFamily="{StaticResource DisplayFont}" TextElement.FontSize="15.5"
                                          TextElement.Foreground="{StaticResource SteelBrush}" />
                        <Border x:Name="Bar" Height="3" Margin="0,0,0,-1" VerticalAlignment="Bottom" CornerRadius="1.5"
                                Background="{StaticResource GraphiteBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource GraphiteBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource GraphiteBrush}" />
                            <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───── Setting rows ───── -->
    <Style TargetType="c:SettingRow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Border Padding="20,13" BorderBrush="{StaticResource RimBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource GraphiteBrush}" />
                                <TextBlock x:Name="Desc" Margin="0,3,0,0" Text="{TemplateBinding Description}" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───── Lists and scrolling ───── -->
    <Style x:Key="DeviceList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style x:Key="DeviceRow" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="0,0,0,4" Padding="12,10" CornerRadius="12" BorderThickness="1"
                            Background="Transparent" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SheetBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RimBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Margin="2" CornerRadius="3" Background="#B3BAC2" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track">
